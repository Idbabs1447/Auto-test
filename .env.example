# Copy to .env (or .env.local) for local development. On Vercel, set these in
# Project → Settings → Environment Variables instead (connecting a Neon database
# from the Vercel "Storage" tab adds DATABASE_URL automatically).

# PostgreSQL connection string
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/app_db

# Public site address used in WhatsApp messages, robots.txt and the sitemap.
# Optional on Vercel — it falls back to the project's production domain.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
